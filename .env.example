# Copy to .env (never commit it) or set these in your shell. On Colab, use Colab Secrets instead (see README).
WKF_PROJECT_DIR=/path/to/project          # where data and outputs go; defaults to /content/drive/MyDrive/biopharma_tiv
SEC_USER_AGENT="Your Name your.email@example.com"   # SEC and OCC require a real name and email
AACT_API_KEY=                              # free key from aact.ctti-clinicaltrials.org (stage 02)
HF_TOKEN=                                  # Hugging Face read token, after accepting the Llama 3.1 license (stage 05)
